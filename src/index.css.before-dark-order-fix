@custom-variant dark (&:where(.dark, .dark *));

@import "tailwindcss";

:root {
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  color: #f8fafc;
  background: #070711;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 75% 0%, rgba(124, 58, 237, 0.14), transparent 32%),
    radial-gradient(circle at 0% 100%, rgba(6, 182, 212, 0.08), transparent 30%),
    #070711;
}

button {
  font: inherit;
}

/* StudySync sidebar scrollbar */
aside::-webkit-scrollbar {
  width: 5px;
}

aside::-webkit-scrollbar-track {
  background: transparent;
}

aside::-webkit-scrollbar-thumb {
  background: rgba(139, 92, 246, 0.25);
  border-radius: 999px;
}

aside::-webkit-scrollbar-thumb:hover {
  background: rgba(139, 92, 246, 0.45);
}

/* ================================
   StudySync UI System
   ================================ */

html {
  background: #070711;
  scrollbar-color: rgba(139, 92, 246, 0.35) transparent;
  scrollbar-width: thin;
}

body {
  overflow-x: hidden;
}

/* Global scrollbar */
::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(139, 92, 246, 0.22);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(139, 92, 246, 0.42);
}

/* Better text selection */
::selection {
  background: rgba(139, 92, 246, 0.35);
  color: #ffffff;
}

/* Smooth interactive elements */
button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

/* Glass panel utility */
.studysync-glass {
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

/* Subtle glow */
.studysync-glow {
  box-shadow:
    0 0 0 1px rgba(139, 92, 246, 0.04),
    0 20px 60px rgba(0, 0, 0, 0.22);
}

/* Focus accessibility */
:focus-visible {
  outline: 2px solid rgba(139, 92, 246, 0.65);
  outline-offset: 2px;
}

/* Prevent accidental horizontal overflow on mobile */
#root {
  min-height: 100vh;
  overflow-x: hidden;
}

/* StudySync ambient background */
.studysync-ambient {
  position: relative;
  isolation: isolate;
}

.studysync-ambient::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to bottom, black, transparent 85%);
}

.studysync-ambient::after {
  content: "";
  position: fixed;
  top: -220px;
  right: -180px;
  width: 520px;
  height: 520px;
  border-radius: 999px;
  pointer-events: none;
  background: rgba(139, 92, 246, 0.07);
  filter: blur(100px);
  z-index: -1;
}

/* ============================================================
   StudySync Light Design System
   ============================================================ */

:root {
  color: #0f172a;
  background: #f5f7fb;
}

html {
  background: #f5f7fb;
  scrollbar-color: rgba(100, 116, 139, 0.28) transparent;
}

body {
  background:
    radial-gradient(circle at 82% 0%, rgba(124, 58, 237, 0.07), transparent 28%),
    radial-gradient(circle at 0% 90%, rgba(14, 165, 233, 0.045), transparent 28%),
    #f5f7fb;
  color: #0f172a;
}

#root {
  background: #f5f7fb;
}

.studysync-ambient {
  background:
    radial-gradient(circle at 85% 0%, rgba(124, 58, 237, 0.045), transparent 25%),
    #f5f7fb;
}

.studysync-ambient::before {
  opacity: 0.35;
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 23, 42, 0.025) 1px, transparent 1px);
}

.studysync-ambient::after {
  background: rgba(124, 58, 237, 0.045);
}

.studysync-glass {
  border: 1px solid #e7eaf1;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 8px 30px rgba(15, 23, 42, 0.045),
    0 1px 2px rgba(15, 23, 42, 0.03);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.studysync-glow {
  box-shadow:
    0 10px 35px rgba(15, 23, 42, 0.055),
    0 1px 2px rgba(15, 23, 42, 0.03);
}

/* Light sidebar */
aside {
  background: rgba(255, 255, 255, 0.94) !important;
  border-color: #e7eaf1 !important;
  box-shadow: 4px 0 25px rgba(15, 23, 42, 0.035);
}

/* Main surfaces */
main {
  background: transparent;
}

/* Improve light-mode cards */
[class*="bg-white"] {
  box-shadow: 0 5px 22px rgba(15, 23, 42, 0.035);
}

/* Light inputs */
input,
textarea,
select {
  color: #0f172a;
}

input::placeholder,
textarea::placeholder {
  color: #94a3b8;
}

/* Better light scrollbar */
::-webkit-scrollbar-thumb {
  background: rgba(100, 116, 139, 0.22);
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(124, 58, 237, 0.32);
}

/* Purple selection */
::selection {
  background: rgba(124, 58, 237, 0.18);
  color: #312e81;
}

/* ============================================================
   STUDYSYNC — PREMIUM GLASSMORPHISM SYSTEM
   ============================================================ */

:root {
  --ss-bg: #eef3fb;
  --ss-white: rgba(255, 255, 255, 0.68);
  --ss-white-strong: rgba(255, 255, 255, 0.84);
  --ss-border: rgba(255, 255, 255, 0.78);
  --ss-border-soft: rgba(148, 163, 184, 0.16);
  --ss-text: #111827;
  --ss-muted: #64748b;
  --ss-purple: #6d4aff;
  --ss-blue: #3b82f6;
  --ss-cyan: #06b6d4;
}

html,
body,
#root {
  background: var(--ss-bg);
}

/* ---------- Atmospheric background ---------- */

body {
  background:
    radial-gradient(
      circle at 76% 4%,
      rgba(124, 92, 255, 0.18),
      transparent 28%
    ),
    radial-gradient(
      circle at 12% 92%,
      rgba(59, 130, 246, 0.13),
      transparent 30%
    ),
    radial-gradient(
      circle at 55% 38%,
      rgba(6, 182, 212, 0.055),
      transparent 30%
    ),
    linear-gradient(135deg, #edf3fb 0%, #f8faff 48%, #eef2ff 100%);
  color: var(--ss-text);
}

/* ---------- Ambient dashboard ---------- */

.studysync-ambient {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 78% 0%,
      rgba(124, 58, 237, 0.09),
      transparent 28%
    ),
    radial-gradient(
      circle at 0% 85%,
      rgba(14, 165, 233, 0.07),
      transparent 26%
    ),
    transparent;
}

.studysync-ambient::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -3;
  opacity: 0.34;
  background-image:
    linear-gradient(
      rgba(99, 102, 241, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(99, 102, 241, 0.025) 1px,
      transparent 1px
    );
  background-size: 46px 46px;
}

.studysync-ambient::after {
  content: "";
  position: fixed;
  width: 520px;
  height: 520px;
  top: -220px;
  right: -140px;
  border-radius: 999px;
  pointer-events: none;
  z-index: -2;
  background:
    radial-gradient(
      circle,
      rgba(124, 92, 255, 0.16),
      rgba(59, 130, 246, 0.05) 42%,
      transparent 70%
    );
  filter: blur(35px);
}

/* ---------- Premium glass ---------- */

.studysync-glass {
  position: relative;
  border: 1px solid var(--ss-border);
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.78),
      rgba(255, 255, 255, 0.48)
    );
  backdrop-filter: blur(28px) saturate(145%);
  -webkit-backdrop-filter: blur(28px) saturate(145%);
  box-shadow:
    0 24px 70px rgba(45, 55, 90, 0.08),
    0 5px 18px rgba(45, 55, 90, 0.045),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.studysync-glass::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.46),
      transparent 38%
    );
}

/* ---------- Sidebar ---------- */

aside {
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.82),
      rgba(247, 249, 255, 0.68)
    ) !important;

  border-right: 1px solid rgba(255, 255, 255, 0.82) !important;

  backdrop-filter: blur(30px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(150%) !important;

  box-shadow:
    14px 0 50px rgba(58, 67, 110, 0.055),
    inset -1px 0 rgba(255, 255, 255, 0.72) !important;
}

/* Sidebar navigation buttons */

aside button {
  transition:
    transform 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease,
    color 180ms ease;
}

aside button:hover {
  transform: translateX(2px);
}

/* Active sidebar item */

aside button.bg-violet-500,
aside button.bg-violet-600,
aside button[class*="bg-violet-"] {
  background:
    linear-gradient(
      135deg,
      rgba(109, 74, 255, 0.96),
      rgba(78, 116, 255, 0.92)
    ) !important;

  color: white !important;

  box-shadow:
    0 12px 28px rgba(109, 74, 255, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.28) !important;
}

/* ---------- Main content ---------- */

main {
  background: transparent;
}

/* ---------- Glass cards ---------- */

main .rounded-2xl.border-slate-200,
main .rounded-3xl.border-slate-200,
main [class*="rounded-2xl"][class*="border-slate-200"],
main [class*="rounded-3xl"][class*="border-slate-200"] {
  position: relative;

  border-color: rgba(255, 255, 255, 0.82) !important;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.78),
      rgba(255, 255, 255, 0.50)
    ) !important;

  backdrop-filter: blur(24px) saturate(140%);
  -webkit-backdrop-filter: blur(24px) saturate(140%);

  box-shadow:
    0 18px 55px rgba(51, 65, 100, 0.07),
    0 4px 15px rgba(51, 65, 100, 0.035),
    inset 0 1px 0 rgba(255, 255, 255, 0.92) !important;

  overflow: hidden;
}

main .rounded-2xl.border-slate-200::after,
main .rounded-3xl.border-slate-200::after,
main [class*="rounded-2xl"][class*="border-slate-200"]::after,
main [class*="rounded-3xl"][class*="border-slate-200"]::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background:
    linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.34),
      transparent 30%
    );
}

/* ---------- Hero ---------- */

main .bg-gradient-to-br {
  border: 1px solid rgba(255, 255, 255, 0.86);

  background:
    radial-gradient(
      circle at 78% 35%,
      rgba(34, 211, 238, 0.19),
      transparent 26%
    ),
    radial-gradient(
      circle at 55% 0%,
      rgba(139, 92, 246, 0.19),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.82),
      rgba(238, 242, 255, 0.58)
    ) !important;

  box-shadow:
    0 28px 80px rgba(71, 78, 140, 0.10),
    0 8px 25px rgba(71, 78, 140, 0.055),
    inset 0 1px 0 rgba(255, 255, 255, 0.95) !important;

  backdrop-filter: blur(30px) saturate(155%);
  -webkit-backdrop-filter: blur(30px) saturate(155%);
}

/* Hero glow */

main .bg-gradient-to-br::before {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  right: 8%;
  top: -180px;
  border-radius: 999px;
  background:
    radial-gradient(
      circle,
      rgba(124, 92, 255, 0.19),
      transparent 68%
    );
  filter: blur(25px);
  pointer-events: none;
}

/* ---------- Typography ---------- */

main h1,
main h2,
main h3,
main h4 {
  letter-spacing: -0.025em;
}

main h2 {
  color: #0f172a;
}

/* ---------- Buttons ---------- */

button.bg-white {
  background:
    linear-gradient(
      135deg,
      #ffffff,
      #f4f6ff
    ) !important;

  border: 1px solid rgba(255, 255, 255, 0.92);

  box-shadow:
    0 8px 20px rgba(30, 41, 80, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

button.bg-violet-600,
button.bg-violet-500 {
  background:
    linear-gradient(
      135deg,
      #6d4aff,
      #7357ff 45%,
      #3b82f6
    ) !important;

  box-shadow:
    0 10px 25px rgba(109, 74, 255, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.22);
}

/* ---------- Inputs / search ---------- */

input,
textarea,
select {
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.52);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

input:focus,
textarea:focus,
select:focus {
  border-color: rgba(109, 74, 255, 0.35);
  box-shadow:
    0 0 0 4px rgba(109, 74, 255, 0.08);
}

/* ---------- Stat cards ---------- */

main .group {
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease;
}

main .group:hover {
  transform: translateY(-3px);

  box-shadow:
    0 22px 48px rgba(45, 55, 90, 0.10),
    0 5px 16px rgba(45, 55, 90, 0.05) !important;
}

/* ---------- Accent glow helpers ---------- */

.text-violet-400,
.text-violet-500,
.text-violet-600 {
  color: #6847ed !important;
}

.bg-violet-500\/10,
.bg-violet-500\/20,
.bg-violet-500\/5 {
  background: rgba(109, 74, 255, 0.09) !important;
}

/* ---------- Glass chips ---------- */

main span[class*="rounded-full"] {
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* ---------- Smooth interaction ---------- */

a,
button {
  transition:
    color 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

/* ---------- Scrollbars ---------- */

html {
  scrollbar-color: rgba(100, 116, 139, 0.24) transparent;
  scrollbar-width: thin;
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(100, 116, 139, 0.20);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(109, 74, 255, 0.35);
}

/* ---------- Selection ---------- */

::selection {
  background: rgba(109, 74, 255, 0.18);
  color: #312e81;
}

/* ---------- Mobile ---------- */

@media (max-width: 1024px) {
  aside {
    box-shadow:
      15px 0 45px rgba(45, 55, 90, 0.12) !important;
  }
}

@media (max-width: 640px) {
  main .rounded-2xl.border-slate-200,
  main .rounded-3xl.border-slate-200 {
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
}

/* ============================================================
   STUDYSYNC — HIGH CONTRAST LIGHT GLASS TYPOGRAPHY
   ============================================================ */

/* Global readable text */
body,
.studysync-ambient {
  color: #172033;
}

/* Main headings */
main h1,
main h2,
main h3,
main h4,
main h5,
main h6 {
  color: #111827 !important;
}

/* Primary text */
main p,
main span,
main label,
main li {
  color: #334155;
}

/* Secondary text */
main .text-slate-400,
main .text-slate-500,
main .text-slate-600 {
  color: #52627a !important;
}

/* Muted text — still clearly visible */
main .text-slate-400 {
  color: #64748b !important;
}

/* Strong text */
main .text-slate-700,
main .text-slate-800,
main .text-slate-900 {
  color: #172033 !important;
}

/* White text should only remain white when sitting on a strong
   colored/dark surface */
main .bg-violet-500 *,
main .bg-violet-600 *,
main .bg-blue-500 *,
main .bg-blue-600 *,
main .bg-gradient-to-br[class*="from-violet"] .text-white {
  color: #ffffff !important;
}

/* Buttons */
button {
  color: #172033;
}

button.bg-white {
  color: #172033 !important;
}

button.bg-white * {
  color: inherit;
}

/* Purple accent text */
.text-violet-400,
.text-violet-500,
.text-violet-600,
.text-purple-400,
.text-purple-500,
.text-purple-600 {
  color: #6246d8 !important;
}

/* Blue accent text */
.text-blue-400,
.text-blue-500,
.text-blue-600 {
  color: #2563eb !important;
}

/* Cyan accent text */
.text-cyan-400,
.text-cyan-500,
.text-cyan-600 {
  color: #0891b2 !important;
}

/* Green accent text */
.text-emerald-400,
.text-emerald-500,
.text-emerald-600 {
  color: #059669 !important;
}

/* Red accent text */
.text-red-400,
.text-red-500,
.text-red-600 {
  color: #dc2626 !important;
}

/* Amber accent text */
.text-amber-400,
.text-amber-500,
.text-amber-600 {
  color: #d97706 !important;
}

/* Sidebar typography */
aside {
  color: #172033 !important;
}

aside button,
aside a {
  color: #334155;
}

aside button:hover,
aside a:hover {
  color: #4f46e5;
}

/* Active sidebar navigation stays white */
aside button[class*="bg-violet-"] {
  color: #ffffff !important;
}

aside button[class*="bg-violet-"] * {
  color: #ffffff !important;
}

/* Header/search */
header,
header * {
  color: #334155;
}

header input {
  color: #172033 !important;
}

header input::placeholder {
  color: #94a3b8 !important;
}

/* Glass cards */
.studysync-glass {
  color: #172033;
}

.studysync-glass h1,
.studysync-glass h2,
.studysync-glass h3,
.studysync-glass h4 {
  color: #111827 !important;
}

.studysync-glass p,
.studysync-glass span {
  color: #52627a;
}

/* Hero text */
main .bg-gradient-to-br h1,
main .bg-gradient-to-br h2,
main .bg-gradient-to-br h3 {
  color: #101828 !important;
}

main .bg-gradient-to-br p {
  color: #475569 !important;
}

/* Hero small labels */
main .bg-gradient-to-br .text-violet-400,
main .bg-gradient-to-br .text-violet-500 {
  color: #6246d8 !important;
}

/* Metric numbers */
main .text-3xl,
main .text-4xl,
main .text-5xl {
  color: #111827;
}

/* Links */
main a {
  color: #4f46e5;
}

main a:hover {
  color: #4338ca;
}

/* Table/list rows */
main [class*="border-white"] p,
main [class*="border-white"] span {
  color: #475569;
}

/* Assignment titles / schedule titles */
main .font-semibold,
main .font-bold {
  color: #172033;
}

/* Preserve white text for colored badges */
.bg-violet-500 .font-semibold,
.bg-violet-600 .font-semibold,
.bg-blue-500 .font-semibold,
.bg-blue-600 .font-semibold {
  color: #ffffff !important;
}

/* Inputs */
input,
textarea,
select {
  color: #172033 !important;
}

input::placeholder,
textarea::placeholder {
  color: #94a3b8 !important;
}

/* Focus ring */
input:focus,
textarea:focus,
select:focus {
  color: #111827 !important;
}

/* Icon buttons */
button svg {
  flex-shrink: 0;
}

/* Notification dots / tiny labels */
.text-xs,
.text-\[11px\],
.text-\[10px\] {
  color: #52627a;
}

/* Keep intentional white text */
.text-white {
  color: #ffffff !important;
}

/* But don't allow invisible inherited text inside light cards */
.bg-white .text-slate-300 {
  color: #64748b !important;
}

.bg-white .text-slate-400 {
  color: #64748b !important;
}

.bg-white .text-slate-500 {
  color: #52627a !important;
}

.bg-white .text-slate-600 {
  color: #334155 !important;
}

/* Glass card contrast */
main [class*="bg-white"] h1,
main [class*="bg-white"] h2,
main [class*="bg-white"] h3,
main [class*="bg-white"] h4 {
  color: #111827 !important;
}

main [class*="bg-white"] p {
  color: #52627a;
}

/* Better contrast for disabled-looking content */
.opacity-50 {
  color: #64748b;
}

.opacity-60 {
  color: #52627a;
}

/* Selection */
::selection {
  background: rgba(99, 70, 220, 0.20);
  color: #111827;
}

/* ============================================================
   STUDYSYNC — GLASS CARD TEXT VISIBILITY FIX
   ============================================================ */

/* Critical: glass cards must never inherit white text */
main .bg-white,
main [class*="bg-white"],
main .studysync-glass {
  color: #172033;
}

/* Main dashboard hero heading */
main section h2 {
  color: #101828 !important;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.65);
}

/* Hero paragraph */
main section h2 + p {
  color: #52627a !important;
}

/* Hero date / eyebrow */
main section p.flex {
  color: #6246d8 !important;
}

/* Dashboard stat labels */
main section .text-\[11px\],
main section .text-\[10px\] {
  color: #64748b !important;
}

/* Dashboard stat values */
main section .text-2xl,
main section .text-3xl,
main section .text-4xl {
  color: #111827 !important;
}

/* Specifically protect the three hero statistics */
main section [class*="Today"],
main section [class*="Goal"],
main section [class*="Streak"] {
  color: #111827;
}

/* Any white text inside translucent LIGHT cards becomes dark.
   We explicitly preserve white text only on genuinely colored
   surfaces below. */
main .bg-white .text-white,
main [class*="bg-white/"] .text-white,
main .studysync-glass .text-white {
  color: #172033 !important;
}

/* Card headings */
main .font-semibold,
main .font-bold {
  color: #172033;
}

/* Card secondary copy */
main .text-slate-400,
main .text-slate-500 {
  color: #5b6b82 !important;
}

/* Card labels */
main .uppercase {
  color: #64748b !important;
}

/* Keep accent labels purple */
main .text-violet-400,
main .text-violet-500,
main .text-violet-600 {
  color: #6246d8 !important;
}

/* Keep positive/metric colors readable */
main .text-emerald-400,
main .text-emerald-500,
main .text-emerald-600 {
  color: #059669 !important;
}

main .text-cyan-400,
main .text-cyan-500,
main .text-cyan-600 {
  color: #0891b2 !important;
}

main .text-blue-400,
main .text-blue-500,
main .text-blue-600 {
  color: #2563eb !important;
}

main .text-amber-400,
main .text-amber-500,
main .text-amber-600 {
  color: #d97706 !important;
}

/* Important numbers inside glass cards */
main .font-bold.text-white,
main .font-semibold.text-white,
main .text-xl.text-white,
main .text-2xl.text-white,
main .text-3xl.text-white,
main .text-4xl.text-white {
  color: #111827 !important;
}

/* Buttons with dark/light backgrounds */
main button.bg-white,
main button.bg-white * {
  color: #172033 !important;
}

/* Preserve white text on actual purple/blue buttons */
main button.bg-violet-500,
main button.bg-violet-600,
main button.bg-blue-500,
main button.bg-blue-600,
main button.bg-violet-500 *,
main button.bg-violet-600 *,
main button.bg-blue-500 *,
main button.bg-blue-600 * {
  color: #ffffff !important;
}

/* Preserve white text for dark Focus Mode surfaces */
main .bg-slate-900,
main .bg-slate-950,
main [class*="from-slate-900"],
main [class*="from-slate-950"] {
  color: #ffffff;
}

main .bg-slate-900 *,
main .bg-slate-950 *,
main [class*="from-slate-900"] *,
main [class*="from-slate-950"] * {
  color: inherit;
}

/* Better contrast for small descriptions */
main p {
  color: #52627a;
}

/* But headings remain dark */
main h1,
main h2,
main h3,
main h4,
main h5,
main h6 {
  color: #111827 !important;
}

/* Interactive links */
main a {
  color: #5541d7;
}

main a:hover {
  color: #4338ca;
}

/* Glass card hover remains premium */
main [class*="rounded-2xl"],
main [class*="rounded-3xl"] {
  transition:
    transform 200ms ease,
    box-shadow 200ms ease,
    border-color 200ms ease;
}

/* Make the glass surface slightly less washed out */
main [class*="bg-white"] {
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.82),
      rgba(255, 255, 255, 0.62)
    ) !important;
}

/* Subtle readable glass highlight */
main [class*="bg-white"]::before {
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.55),
      transparent 34%
    );
}

/* Accessibility — minimum readable muted text */
main .text-xs,
main .text-\[10px\],
main .text-\[11px\] {
  color: #5b6b82;
}


/* =========================================================
   STUDYSYNC — GLOBAL DARK THEME
   ========================================================= */

html[data-theme="dark"] {
  color-scheme: dark;
  background: #070a12;
}

html[data-theme="dark"] body {
  background: #070a12 !important;
  color: #e5e7eb !important;
}

/* ---------------------------------------------------------
   GLOBAL PAGE BACKGROUNDS
   --------------------------------------------------------- */

html[data-theme="dark"] #root {
  background:
    radial-gradient(
      circle at 15% 5%,
      rgba(124, 58, 237, 0.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 15%,
      rgba(37, 99, 235, 0.08),
      transparent 28%
    ),
    #070a12 !important;
  min-height: 100vh;
}

/* Common light backgrounds */
html[data-theme="dark"] .bg-white,
html[data-theme="dark"] .bg-white\/95,
html[data-theme="dark"] .bg-white\/90,
html[data-theme="dark"] .bg-white\/80,
html[data-theme="dark"] .bg-white\/75,
html[data-theme="dark"] .bg-white\/70,
html[data-theme="dark"] .bg-white\/60,
html[data-theme="dark"] .bg-white\/50 {
  background-color: #111827 !important;
}

/* Slate backgrounds */
html[data-theme="dark"] .bg-slate-50 {
  background-color: #0f172a !important;
}

html[data-theme="dark"] .bg-slate-100 {
  background-color: #172033 !important;
}

html[data-theme="dark"] .bg-slate-200 {
  background-color: #1e293b !important;
}

/* ---------------------------------------------------------
   GLOBAL TEXT
   --------------------------------------------------------- */

html[data-theme="dark"] .text-slate-950,
html[data-theme="dark"] .text-slate-900,
html[data-theme="dark"] .text-slate-800,
html[data-theme="dark"] .text-slate-700 {
  color: #f1f5f9 !important;
}

html[data-theme="dark"] .text-slate-600 {
  color: #cbd5e1 !important;
}

html[data-theme="dark"] .text-slate-500 {
  color: #94a3b8 !important;
}

html[data-theme="dark"] .text-slate-400 {
  color: #64748b !important;
}

html[data-theme="dark"] .text-slate-300 {
  color: #94a3b8 !important;
}

/* ---------------------------------------------------------
   GLOBAL BORDERS
   --------------------------------------------------------- */

html[data-theme="dark"] .border-slate-50,
html[data-theme="dark"] .border-slate-100,
html[data-theme="dark"] .border-slate-200,
html[data-theme="dark"] .border-slate-300 {
  border-color: #263449 !important;
}

/* ---------------------------------------------------------
   SIDEBAR
   --------------------------------------------------------- */

html[data-theme="dark"] aside {
  background: #090e1a !important;
  border-color: #1e293b !important;
  color: #e5e7eb !important;
}

html[data-theme="dark"] aside .bg-white,
html[data-theme="dark"] aside .bg-white\/80,
html[data-theme="dark"] aside .bg-white\/90 {
  background-color: #111827 !important;
}

html[data-theme="dark"] aside a,
html[data-theme="dark"] aside button {
  color: #94a3b8;
}

html[data-theme="dark"] aside a:hover,
html[data-theme="dark"] aside button:hover {
  color: #f8fafc;
  background-color: #172033;
}

/* Keep active navigation purple */
html[data-theme="dark"] aside .bg-violet-500,
html[data-theme="dark"] aside .bg-violet-600,
html[data-theme="dark"] aside .bg-purple-500,
html[data-theme="dark"] aside .bg-purple-600 {
  color: #ffffff !important;
}

/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

html[data-theme="dark"] header {
  background: #0d1320 !important;
  border-color: #1e293b !important;
  color: #e5e7eb !important;
}

html[data-theme="dark"] header input {
  background: #172033 !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

html[data-theme="dark"] header button {
  background-color: #1e293b !important;
  color: #cbd5e1 !important;
}

/* ---------------------------------------------------------
   CARDS
   --------------------------------------------------------- */

html[data-theme="dark"] .rounded-xl,
html[data-theme="dark"] .rounded-2xl,
html[data-theme="dark"] .rounded-3xl,
html[data-theme="dark"] .rounded-\[20px\],
html[data-theme="dark"] .rounded-\[24px\],
html[data-theme="dark"] .rounded-\[28px\],
html[data-theme="dark"] .rounded-\[32px\] {
  border-color: #263449;
}

/* ---------------------------------------------------------
   INPUTS
   --------------------------------------------------------- */

html[data-theme="dark"] input,
html[data-theme="dark"] textarea,
html[data-theme="dark"] select {
  background: #0f172a !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

html[data-theme="dark"] input:focus,
html[data-theme="dark"] textarea:focus,
html[data-theme="dark"] select:focus {
  border-color: #8b5cf6 !important;
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.14) !important;
}

html[data-theme="dark"] input::placeholder,
html[data-theme="dark"] textarea::placeholder {
  color: #64748b !important;
}

html[data-theme="dark"] option {
  background: #0f172a;
  color: #f8fafc;
}

/* ---------------------------------------------------------
   BUTTONS
   --------------------------------------------------------- */

html[data-theme="dark"] button:not(.bg-violet-500):not(.bg-violet-600) {
  border-color: #334155;
}

/* Purple primary actions stay purple */
html[data-theme="dark"] .bg-violet-500,
html[data-theme="dark"] .bg-violet-600,
html[data-theme="dark"] .bg-purple-500,
html[data-theme="dark"] .bg-purple-600 {
  color: #ffffff !important;
}

/* ---------------------------------------------------------
   DASHBOARD / WORKSPACE PANELS
   --------------------------------------------------------- */

html[data-theme="dark"] [class*="shadow"] {
  --tw-shadow-color: rgba(0, 0, 0, 0.35);
}

/* ---------------------------------------------------------
   TABLES / LISTS
   --------------------------------------------------------- */

html[data-theme="dark"] table {
  color: #e5e7eb;
}

html[data-theme="dark"] th {
  color: #94a3b8 !important;
  background: #0f172a !important;
}

html[data-theme="dark"] td {
  border-color: #263449 !important;
}

html[data-theme="dark"] tr:hover {
  background: rgba(51, 65, 85, 0.28) !important;
}

/* ---------------------------------------------------------
   MODALS
   --------------------------------------------------------- */

html[data-theme="dark"] [class*="fixed"][class*="inset-0"] {
  color: #e5e7eb;
}

html[data-theme="dark"] .bg-slate-950\/45,
html[data-theme="dark"] .bg-slate-950\/50,
html[data-theme="dark"] .bg-black\/40,
html[data-theme="dark"] .bg-black\/50 {
  background-color: rgba(0, 0, 0, 0.72) !important;
}

/* ---------------------------------------------------------
   DROPDOWNS
   --------------------------------------------------------- */

html[data-theme="dark"] [role="menu"],
html[data-theme="dark"] [role="listbox"] {
  background: #111827 !important;
  border-color: #334155 !important;
  color: #e5e7eb !important;
}

/* ---------------------------------------------------------
   LINKS
   --------------------------------------------------------- */

html[data-theme="dark"] .text-blue-600,
html[data-theme="dark"] .text-indigo-600,
html[data-theme="dark"] .text-violet-600,
html[data-theme="dark"] .text-purple-600 {
  color: #a78bfa !important;
}

/* ---------------------------------------------------------
   SUCCESS / INFO / WARNING / DANGER PANELS
   --------------------------------------------------------- */

html[data-theme="dark"] .bg-emerald-50 {
  background-color: #062e25 !important;
}

html[data-theme="dark"] .bg-green-50 {
  background-color: #082b20 !important;
}

html[data-theme="dark"] .bg-blue-50 {
  background-color: #0c1f38 !important;
}

html[data-theme="dark"] .bg-indigo-50 {
  background-color: #171538 !important;
}

html[data-theme="dark"] .bg-violet-50 {
  background-color: #21153d !important;
}

html[data-theme="dark"] .bg-purple-50 {
  background-color: #21153d !important;
}

html[data-theme="dark"] .bg-amber-50 {
  background-color: #30230b !important;
}

html[data-theme="dark"] .bg-yellow-50 {
  background-color: #30230b !important;
}

html[data-theme="dark"] .bg-red-50 {
  background-color: #351318 !important;
}

/* ---------------------------------------------------------
   ICON BACKGROUNDS
   --------------------------------------------------------- */

html[data-theme="dark"] .bg-slate-100 {
  color: #cbd5e1;
}

/* ---------------------------------------------------------
   PROGRESS BARS
   --------------------------------------------------------- */

html[data-theme="dark"] [class*="bg-slate-200"] {
  background-color: #263449 !important;
}

/* ---------------------------------------------------------
   DIVIDERS
   --------------------------------------------------------- */

html[data-theme="dark"] .divide-slate-100 > :not([hidden]) ~ :not([hidden]),
html[data-theme="dark"] .divide-slate-200 > :not([hidden]) ~ :not([hidden]) {
  border-color: #263449 !important;
}

/* ---------------------------------------------------------
   FOCUS MODE
   --------------------------------------------------------- */

html[data-theme="dark"] [data-focus-mode],
html[data-theme="dark"] .focus-mode {
  color: #f8fafc;
}

/* ---------------------------------------------------------
   SCROLLBAR
   --------------------------------------------------------- */

html[data-theme="dark"] ::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

html[data-theme="dark"] ::-webkit-scrollbar-track {
  background: #070a12;
}

html[data-theme="dark"] ::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 999px;
}

html[data-theme="dark"] ::-webkit-scrollbar-thumb:hover {
  background: #475569;
}

/* ---------------------------------------------------------
   SMOOTH THEME TRANSITION
   --------------------------------------------------------- */

html[data-theme="dark"],
html[data-theme="dark"] body,
html[data-theme="dark"] #root,
html[data-theme="dark"] aside,
html[data-theme="dark"] header {
  transition:
    background-color 180ms ease,
    color 180ms ease,
    border-color 180ms ease;
}

/* =========================================================
   STUDYSYNC DARK BLUE CARD SYSTEM
   ========================================================= */

html[data-theme="dark"] .bg-white,
html[data-theme="dark"] .bg-white\/95,
html[data-theme="dark"] .bg-white\/90,
html[data-theme="dark"] .bg-white\/80,
html[data-theme="dark"] .bg-white\/75,
html[data-theme="dark"] .bg-white\/70,
html[data-theme="dark"] .bg-white\/60,
html[data-theme="dark"] .bg-white\/50 {
  background:
    linear-gradient(
      145deg,
      rgba(20, 47, 79, 0.96),
      rgba(12, 32, 58, 0.96)
    ) !important;
  border-color: rgba(96, 165, 250, 0.28) !important;
  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(147, 197, 253, 0.08) !important;
}

/* Dashboard statistic cards */
html[data-theme="dark"] .bg-slate-50,
html[data-theme="dark"] .bg-slate-100 {
  background:
    linear-gradient(
      145deg,
      rgba(22, 52, 87, 0.98),
      rgba(13, 35, 63, 0.98)
    ) !important;
}

/* Inner assignment cards */
html[data-theme="dark"] .bg-white\/80 .bg-white,
html[data-theme="dark"] .bg-white\/90 .bg-white {
  background:
    linear-gradient(
      145deg,
      #16375c,
      #102b4b
    ) !important;
}

/* Blue card borders */
html[data-theme="dark"] [class*="rounded-2xl"],
html[data-theme="dark"] [class*="rounded-3xl"],
html[data-theme="dark"] [class*="rounded-[24px]"] {
  border-color: rgba(96, 165, 250, 0.30) !important;
}

/* Card headings */
html[data-theme="dark"] .text-slate-900,
html[data-theme="dark"] .text-slate-800,
html[data-theme="dark"] .text-slate-700 {
  color: #f1f7ff !important;
}

/* Card descriptions */
html[data-theme="dark"] .text-slate-600 {
  color: #c2d4e8 !important;
}

html[data-theme="dark"] .text-slate-500 {
  color: #91a9c4 !important;
}

/* Assignment progress background */
html[data-theme="dark"] .bg-slate-200 {
  background-color: #294563 !important;
}

/* Blue glass glow */
html[data-theme="dark"] .shadow-sm,
html[data-theme="dark"] .shadow-md,
html[data-theme="dark"] .shadow-lg {
  --tw-shadow-color: rgba(0, 0, 0, 0.28);
}

/* Keep purple progress bars */
html[data-theme="dark"] .bg-violet-500,
html[data-theme="dark"] .bg-violet-600,
html[data-theme="dark"] .bg-purple-500,
html[data-theme="dark"] .bg-purple-600 {
  background-color: #8b5cf6 !important;
}

/* Completed green elements */
html[data-theme="dark"] .bg-emerald-500 {
  background-color: #10b981 !important;
}

/* Blue icon containers */
html[data-theme="dark"] .bg-blue-50 {
  background-color: rgba(30, 64, 175, 0.22) !important;
}

html[data-theme="dark"] .bg-cyan-50 {
  background-color: rgba(8, 145, 178, 0.20) !important;
}

/* Cards should remain clearly separated from page */
html[data-theme="dark"] main {
  background: transparent !important;
}

/* Dark blue scrollbar */
html[data-theme="dark"] ::-webkit-scrollbar-track {
  background: #060b16;
}

html[data-theme="dark"] ::-webkit-scrollbar-thumb {
  background: #24466d;
}

html[data-theme="dark"] ::-webkit-scrollbar-thumb:hover {
  background: #356493;
}
