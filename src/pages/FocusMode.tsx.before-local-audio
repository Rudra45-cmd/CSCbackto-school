<section className="mt-8">
  <div className="mb-4">
    <p className="text-[10px] font-bold uppercase tracking-[0.18em] text-violet-500">
      Your Progress
    </p>

    <h2 className="mt-1 text-lg font-bold text-slate-900">
      Focus Statistics
    </h2>
  </div>

  {(() => {
    const now = new Date();

    const todaySeconds = sessions.reduce((total, session) => {
      if (!session.started_at) return total;

      const date = new Date(session.started_at);

      if (
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate()
      ) {
        return (
          total +
          (session.duration_seconds ||
            session.duration_minutes * 60)
        );
      }

      return total;
    }, 0);

    const startOfWeek = new Date(now);
    const day = startOfWeek.getDay();

    startOfWeek.setDate(
      startOfWeek.getDate() -
        (day === 0 ? 6 : day - 1),
    );

    startOfWeek.setHours(0, 0, 0, 0);

    const weekSeconds = sessions.reduce((total, session) => {
      if (!session.started_at) return total;

      const date = new Date(session.started_at);

      if (date >= startOfWeek && date <= now) {
        return (
          total +
          (session.duration_seconds ||
            session.duration_minutes * 60)
        );
      }

      return total;
    }, 0);

    const totalSeconds = sessions.reduce(
      (total, session) =>
        total +
        (session.duration_seconds ||
          session.duration_minutes * 60),
      0,
    );

    return (
      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div className="rounded-2xl border border-violet-100 bg-violet-50/70 p-5">
          <p className="text-[10px] font-bold uppercase tracking-wider text-violet-500">
            Today's Focus
          </p>

          <p className="mt-2 text-2xl font-bold text-violet-700">
            {formatDuration(todaySeconds)}
          </p>

          <p className="mt-3 text-[10px] font-medium text-violet-500">
            Focus completed today
          </p>
        </div>

        <div className="rounded-2xl border border-sky-100 bg-sky-50/70 p-5">
          <p className="text-[10px] font-bold uppercase tracking-wider text-sky-500">
            This Week
          </p>

          <p className="mt-2 text-2xl font-bold text-sky-700">
            {formatDuration(weekSeconds)}
          </p>

          <p className="mt-3 text-[10px] font-medium text-sky-500">
            Monday → today
          </p>
        </div>

        <div className="rounded-2xl border border-emerald-100 bg-emerald-50/70 p-5">
          <p className="text-[10px] font-bold uppercase tracking-wider text-emerald-500">
            Sessions
          </p>

          <p className="mt-2 text-2xl font-bold text-emerald-700">
            {sessions.length}
          </p>

          <p className="mt-3 text-[10px] font-medium text-emerald-500">
            Completed focus sessions
          </p>
        </div>

        <div className="rounded-2xl border border-amber-100 bg-amber-50/70 p-5">
          <p className="text-[10px] font-bold uppercase tracking-wider text-amber-500">
            Total Focus
          </p>

          <p className="mt-2 text-2xl font-bold text-amber-700">
            {formatDuration(totalSeconds)}
          </p>

          <p className="mt-3 text-[10px] font-medium text-amber-500">
            All recorded sessions
          </p>
        </div>
      </div>
    );
  })()}
</section>

