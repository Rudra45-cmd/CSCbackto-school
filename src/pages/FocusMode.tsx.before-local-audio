  const [message, setMessage] = useState("");

  // Ambient sound state
  const [ambientMenuOpen, setAmbientMenuOpen] = useState(false);
  const [activeSound, setActiveSound] =
    useState<AmbientSoundId>("deep-focus");
  const [soundPlaying, setSoundPlaying] = useState(false);
  const [soundVolume, setSoundVolume] = useState(0.32);

  const audioRef = useRef<HTMLAudioElement | null>(null);

  // Quick notes
  const [quickNote, setQuickNote] = useState("");
  const [quickNotes, setQuickNotes] = useState<QuickNote[]>([]);
  const [noteSaved, setNoteSaved] = useState(false);

  const [sessionComplete, setSessionComplete] = useState(false);
  const [completedSeconds, setCompletedSeconds] = useState(0);

  const [breakMode, setBreakMode] = useState(false);
  const [breakSeconds, setBreakSeconds] = useState(5 * 60);
  const [breakRunning, setBreakRunning] = useState(false);

  const selectedAssignment = useMemo(
    () =>
      assignments.find(
        (assignment) => assignment.id === selectedAssignmentId,
      ) ?? null,
    [assignments, selectedAssignmentId],
  );

  const activeSoundMeta =
    AMBIENT_SOUNDS.find((sound) => sound.id === activeSound) ??
    AMBIENT_SOUNDS[0];

  function stopAmbientSound() {
    const audio = audioRef.current;

    if (audio) {
      audio.pause();
      audio.currentTime = 0;
    }

    setSoundPlaying(false);
  }

  async function playAmbientSound() {
    const sound = activeSoundMeta;

    let audio = audioRef.current;

    if (!audio) {
      audio = new Audio(sound.src);
      audio.loop = true;
      audio.preload = "auto";
      audio.volume = soundVolume;
      audioRef.current = audio;
    }

    if (audio.src !== new URL(sound.src, window.location.origin).href) {
      audio.pause();
      audio.currentTime = 0;
      audio.src = sound.src;
      audio.loop = true;
      audio.volume = soundVolume;
    }

    audio.volume = soundVolume;

    try {
      await audio.play();
      setSoundPlaying(true);
    } catch (error) {
      console.error("Unable to play focus music:", error);
      setSoundPlaying(false);
    }
  }

  function toggleAmbientSound() {
    if (soundPlaying) {
      const audio = audioRef.current;

      if (audio) {
        audio.pause();
      }

      setSoundPlaying(false);
      return;
    }

    void playAmbientSound();
  }

  function changeAmbientSound(soundId: AmbientSoundId) {
    setActiveSound(soundId);
    setAmbientMenuOpen(false);

    const sound = AMBIENT_SOUNDS.find((item) => item.id === soundId);

    if (!sound) return;

    const audio = audioRef.current;

    if (!audio) return;

    audio.pause();
    audio.src = sound.src;
    audio.loop = true;
    audio.volume = soundVolume;

    if (soundPlaying) {
      void audio.play().catch((error) => {
        console.error("Unable to switch focus music:", error);
        setSoundPlaying(false);
      });
    }
  }

  useEffect(() => {
    const audio = audioRef.current;

    if (audio) {
      audio.volume = soundVolume;
    }
  }, [soundVolume]);

  useEffect(() => {
    return () => {
      const audio = audioRef.current;

      if (audio) {
        audio.pause();
        audio.src = "";
      }
    };
  }, []);


  function stopAmbientSound() {
    const audio = audioRef.current;

    if (!audio) {
      setSoundPlaying(false);
      return;
    }

    audio.pause();
    audio.currentTime = 0;
    audioRef.current = null;

    setSoundPlaying(false);
  }

  async function startAmbientSound(soundId: AmbientSoundId) {
    const sound = AMBIENT_SOUNDS.find(
      (item) => item.id === soundId,
    );

    if (!sound) return;

    stopAmbientSound();

    const audio = new Audio(sound.url);

    audio.loop = true;
    audio.volume = soundVolume;
    audio.preload = "auto";

    audioRef.current = audio;

    audio.addEventListener("ended", () => {
      setSoundPlaying(false);
    });

    audio.addEventListener("error", () => {
      setSoundPlaying(false);
      setMessage(
        `Unable to load ${sound.name}. Check the audio URL.`,
      );
    });

    try {
      await audio.play();

      setActiveSound(soundId);
      setSoundPlaying(true);
      setAmbientMenuOpen(false);
      setMessage("");
    } catch (error) {
      console.error("Failed to play ambient sound:", error);
      setSoundPlaying(false);
      setMessage(
        "The audio could not be played. Check the audio URL.",
      );
    }
  }

  function toggleAmbientSound() {
    const audio = audioRef.current;

    if (!audio) {
      void startAmbientSound(activeSound);
      return;
    }

    if (audio.paused) {
      void audio.play();
      setSoundPlaying(true);
    } else {
      audio.pause();
      setSoundPlaying(false);
    }
  }

  function handleSoundVolume(value: number) {
    setSoundVolume(value);

    if (audioRef.current) {
      audioRef.current.volume = value;
    }
  }

  function applyFocusTool(secondsValue: number, label: string) {
    setSelectedLength(secondsValue);
    setActiveSessionLength(secondsValue);
    setSeconds(secondsValue);
    setSessionComplete(false);
    setBreakMode(false);

    const startedAt =
      sessionStartedAt || new Date().toISOString();

    setSessionStartedAt(startedAt);

    // If a focus session is already running, immediately
    // switch the timer to the selected duration.
    if (running) {
      const endAt = Date.now() + secondsValue * 1000;

      localStorage.setItem(
        TIMER_STORAGE_KEY,
        JSON.stringify({
          running: true,
          endAt,
          seconds: secondsValue,
          sessionStartedAt: startedAt,
          assignmentId: activeAssignmentId,
          assignmentTitle: activeAssignmentTitle,
          subject: activeSubject,
          sessionLength: secondsValue,
        } satisfies TimerStorage),
      );

      setMessage(`${label} timer changed.`);
      return;
    }

    setMessage(`${label} selected.`);
  }

  function getNotesKey() {
    return `studysync_focus_notes_${
      activeAssignmentId ?? "general"
    }`;
  }

  function saveQuickNote() {
    const trimmed = quickNote.trim();

    if (!trimmed) {
      setMessage("Write a note before saving.");
      return;
    }

    const key = getNotesKey();

    const newNote: QuickNote = {
      id: `${Date.now()}-${Math.random()
        .toString(36)
        .slice(2, 8)}`,
      text: trimmed,
      createdAt: new Date().toISOString(),
    };

    const updatedNotes = [newNote, ...quickNotes];

    setQuickNotes(updatedNotes);
    setQuickNote("");
    setNoteSaved(true);
    setMessage("Note saved.");

    localStorage.setItem(
      key,
      JSON.stringify(updatedNotes),
    );

    window.setTimeout(() => {
      setNoteSaved(false);
    }, 1800);
  }

  function deleteQuickNote(noteId: string) {
    const key = getNotesKey();

    const updatedNotes = quickNotes.filter(
      (note) => note.id !== noteId,
    );

    setQuickNotes(updatedNotes);

    localStorage.setItem(
      key,
      JSON.stringify(updatedNotes),
    );

    setMessage("Note deleted.");
  }

  const todaySessions = useMemo(() => {
    const today = new Date();

    return sessions.filter(
      (session) =>
        session.started_at &&
        sameDay(session.started_at, today),
    );
  }, [sessions]);

async function deleteSession(sessionId: number) {
  try {
    await apiFetch(`/api/study-sessions/${sessionId}`, {
      method: "DELETE",
      headers: {
        Authorization: `Bearer ${getToken()}`,
      },
    });

    setSessions((current) =>
      current.filter((session) => session.id !== sessionId),
    );

    setMessage("Focus session deleted.");
    notifyAssignmentsChanged();
  } catch (error) {
    console.error("Failed to delete session:", error);
    setMessage(
      error instanceof Error
        ? error.message
        : "Unable to delete focus session.",
    );
  }
}

function getDayTotal(sessionsForDay: StudySession[]) {
  return sessionsForDay.reduce((total, session) => {
    return (
      total +
      (session.duration_seconds ||
        session.duration_minutes * 60)
    );
  }, 0);
}

  const todaySeconds = useMemo(
    () =>
      todaySessions.reduce(
        (total, session) =>
          total +
          (session.duration_seconds ||
            session.duration_minutes * 60),
        0,
      ),
    [todaySessions],
  );

  const todaySessionCount = todaySessions.length;

  const progress =
    activeSessionLength > 0
      ? Math.min(
          100,
          Math.max(
            0,
            ((activeSessionLength - seconds) / activeSessionLength) * 100,
          ),
        )
      : 0;

  const goalSeconds = 3 * 60 * 60;
  const goalProgress = Math.min(
    100,
    Math.round((todaySeconds / goalSeconds) * 100),
  );

  async function loadAssignments() {
    const token = getToken();

    if (!token) return;

    try {
      const [assignmentResponse, userResponse] = await Promise.all([
        apiFetch<AssignmentsResponse>("/api/assignments", {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }),
        apiFetch<{
          user: {
            subjects: string[] | string;
          };
        }>("/api/auth/me", {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }),
      ]);

      setAssignments(
        assignmentResponse.assignments.filter(
          (assignment) => !assignment.completed,
        ),
      );

      const rawSubjects = userResponse.user?.subjects;

      const subjects = Array.isArray(rawSubjects)
        ? rawSubjects
            .map((subject) => subject.trim())
            .filter(Boolean)
        : typeof rawSubjects === "string"
          ? rawSubjects
              .split(",")
              .map((subject) => subject.trim())
              .filter(Boolean)
          : [];

      setStudentSubjects(subjects);

      if (subjects.length > 0) {
        setSelectedSubject((current) => current || subjects[0]);
      }
    } catch (error) {
      console.error("Failed to load Focus Mode setup:", error);
    }
  }

  async function loadSessions() {
    const token = getToken();

    if (!token) return;

    try {
      const response = await apiFetch<SessionsResponse>(
        "/api/study-sessions",
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      setSessions(response.sessions);
    } catch (error) {
      console.error("Failed to load focus sessions:", error);
    }
  }

  useEffect(() => {
    async function load() {
      setLoading(true);
      await Promise.all([loadAssignments(), loadSessions()]);
      setLoading(false);
    }

    void load();
  }, []);

  useEffect(() => {
    const key = `studysync_focus_notes_${
      activeAssignmentId ?? "general"
    }`;

    const raw = localStorage.getItem(key);

    if (!raw) {
      setQuickNotes([]);
      setQuickNote("");
      setNoteSaved(false);
      return;
    }

    try {
      const parsed = JSON.parse(raw);

      if (Array.isArray(parsed)) {
        setQuickNotes(parsed);
      } else if (typeof parsed === "string" && parsed.trim()) {
        // Migrate the previous single-note format.
        const migrated: QuickNote = {
          id: `${Date.now()}`,
          text: parsed,
          createdAt: new Date().toISOString(),
        };

        setQuickNotes([migrated]);

        localStorage.setItem(
          key,
          JSON.stringify([migrated]),
        );
      } else {
        setQuickNotes([]);
      }
    } catch {
      setQuickNotes([]);
    }

    setQuickNote("");
    setNoteSaved(false);
  }, [activeAssignmentId]);

  useEffect(() => {
    return () => {
      if (audioRef.current) {
        audioRef.current.pause();
        audioRef.current.currentTime = 0;
        audioRef.current = null;
      }
    };
  }, []);

  // Restore active session after refresh.
  useEffect(() => {
    const raw = localStorage.getItem(TIMER_STORAGE_KEY);

    if (!raw) return;

    try {
      const saved = JSON.parse(raw) as TimerStorage;

      setSessionStartedAt(saved.sessionStartedAt);
      setActiveAssignmentId(saved.assignmentId);
      setActiveAssignmentTitle(saved.assignmentTitle);
      setActiveSubject(saved.subject);
      setActiveSessionLength(saved.sessionLength);

      if (saved.running && saved.endAt) {
        const remaining = Math.max(
          0,
          Math.ceil((saved.endAt - Date.now()) / 1000),
        );

        if (remaining > 0) {
          setSeconds(remaining);
          setRunning(true);
        } else {
          localStorage.removeItem(TIMER_STORAGE_KEY);
        }
      } else {
        setSeconds(saved.seconds);
      }
    } catch {
      localStorage.removeItem(TIMER_STORAGE_KEY);
    }
  }, []);

  // Persistent active timer.
  useEffect(() => {
    if (!running) return;

    const timer = window.setInterval(() => {
      const raw = localStorage.getItem(TIMER_STORAGE_KEY);

      if (!raw) {
        setRunning(false);
        return;
      }

      try {
        const saved = JSON.parse(raw) as TimerStorage;

        if (!saved.endAt) {
          setRunning(false);
          return;
        }

        const remaining = Math.max(
          0,
          Math.ceil((saved.endAt - Date.now()) / 1000),
        );

        if (remaining <= 0) {
          setSeconds(0);
          setRunning(false);
          localStorage.removeItem(TIMER_STORAGE_KEY);
          void finishSession(saved.sessionLength);
          return;
        }

        setSeconds(remaining);

        localStorage.setItem(
          TIMER_STORAGE_KEY,
          JSON.stringify({
            ...saved,
            seconds: remaining,
            running: true,
          }),
        );
      } catch {
        localStorage.removeItem(TIMER_STORAGE_KEY);
        setRunning(false);
      }
    }, 250);

    return () => window.clearInterval(timer);
  }, [running]);

  // Break timer.
  useEffect(() => {
    if (!breakRunning) return;

    const timer = window.setInterval(() => {
      setBreakSeconds((value) => {
        if (value <= 1) {
          setBreakRunning(false);
          return 5 * 60;
        }

        return value - 1;
      });
    }, 1000);

    return () => window.clearInterval(timer);
  }, [breakRunning]);

  async function finishSession(durationSeconds: number) {
    const token = getToken();

    if (!token || saving) return;

    const actualDuration = Math.max(0, Math.round(durationSeconds));

    if (actualDuration < 1) {
      return;
    }

    try {
      setSaving(true);
      setMessage("");

      const startedAt =
        sessionStartedAt ||
        new Date(Date.now() - actualDuration * 1000).toISOString();

      const endedAt = new Date().toISOString();

      const response = await apiFetch<SessionResponse>(
        "/api/study-sessions",
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            assignment_id: activeAssignmentId,
            subject: activeSubject || "General Study",
            duration_seconds: actualDuration,
            started_at: startedAt,
            ended_at: endedAt,
          }),
        },
      );

      setSessions((current) => [
        response.session,
        ...current,
      ]);

      setCompletedSeconds(actualDuration);
      setSessionComplete(true);
      setRunning(false);
      setSeconds(activeSessionLength);
      setSessionStartedAt(null);

      localStorage.removeItem(TIMER_STORAGE_KEY);

      notifyAssignmentsChanged();
    } catch (error) {
      setMessage(
        error instanceof Error
          ? error.message
          : "Unable to save the focus session.",
      );
    } finally {
      setSaving(false);
    }
  }

  function startSession() {
    const duration =
      selectedLength === -1
        ? Math.max(1, customMinutes) * 60
        : selectedLength;

    let assignmentId: number | null = null;
    let assignmentTitle = "";
    let subject = "";

    if (selectionMode === "assignment") {
      const assignment = assignments.find(
        (item) => item.id === selectedAssignmentId,
      );

      if (!assignment) {
        setMessage("Choose an assignment before starting.");
        return;
      }

      assignmentId = assignment.id;
      assignmentTitle = assignment.title;
      subject = assignment.subject;
    } else {
      subject = selectedSubject.trim();

      if (!subject) {
        setMessage("Choose a subject before starting.");
        return;
      }
    }

    const startedAt = new Date().toISOString();
    const endAt = Date.now() + duration * 1000;

    setActiveAssignmentId(assignmentId);
    setActiveAssignmentTitle(assignmentTitle);
    setActiveSubject(subject);

    if (assignmentId !== null) {
      const assignment = assignments.find(
        (item) => item.id === assignmentId,
      );

      setActiveDueDate(assignment?.due_date || "");
    } else {
      setActiveDueDate("");
    }

    setActiveSessionLength(duration);
    setSessionStartedAt(startedAt);
    setSeconds(duration);
    setRunning(true);
    setSessionComplete(false);
    setBreakMode(false);
    setMessage("");

    localStorage.setItem(
      TIMER_STORAGE_KEY,
      JSON.stringify({
        running: true,
        endAt,
        seconds: duration,
        sessionStartedAt: startedAt,
        assignmentId,
        assignmentTitle,
        subject,
        sessionLength: duration,
      } satisfies TimerStorage),
    );
  }

  function togglePause() {
    if (running) {
      setRunning(false);

      localStorage.setItem(
        TIMER_STORAGE_KEY,
        JSON.stringify({
          running: false,
          endAt: null,
          seconds,
          sessionStartedAt,
          assignmentId: activeAssignmentId,
          assignmentTitle: activeAssignmentTitle,
          subject: activeSubject,
          sessionLength: activeSessionLength,
        } satisfies TimerStorage),
      );

      return;
    }

    const endAt = Date.now() + seconds * 1000;

    setRunning(true);

    localStorage.setItem(
      TIMER_STORAGE_KEY,
      JSON.stringify({
        running: true,
        endAt,
        seconds,
        sessionStartedAt,
        assignmentId: activeAssignmentId,
        assignmentTitle: activeAssignmentTitle,
        subject: activeSubject,
        sessionLength: activeSessionLength,
      } satisfies TimerStorage),
    );
  }

  function resetSession() {
    setRunning(false);
    setSeconds(activeSessionLength);
    setSessionStartedAt(null);
    localStorage.removeItem(TIMER_STORAGE_KEY);
  }

  function addFiveMinutes() {
    const newSeconds = seconds + 5 * 60;

    setSeconds(newSeconds);
    setActiveSessionLength((current) => current + 5 * 60);

    if (running) {
      localStorage.setItem(
        TIMER_STORAGE_KEY,
        JSON.stringify({
          running: true,
          endAt: Date.now() + newSeconds * 1000,
          seconds: newSeconds,
          sessionStartedAt,
          assignmentId: activeAssignmentId,
          assignmentTitle: activeAssignmentTitle,
          subject: activeSubject,
          sessionLength: activeSessionLength + 5 * 60,
        } satisfies TimerStorage),
      );
    }
  }

  function exitFocus() {
    if (
      running ||
