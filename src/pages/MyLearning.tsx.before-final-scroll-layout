  async function sendPrompt(value = prompt) {
    scrollToMainAI();

  const trimmed = value.trim();
  if (!trimmed || sending) return;

  const userMessage = {
    id: Date.now(),
    role: "user" as const,
    text: trimmed,
  };

  const assistantId = Date.now() + 0.5;

  setMessages((current) => [
    ...current,
    userMessage,
    {
      id: assistantId,
      role: "assistant" as const,
      text: "",
      thinking: true,
    },
  ]);

  setPrompt("");
  setSending(true);

  try {
    const response = await apiFetch<{ reply: string }>("/api/ai/chat", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${getToken()}`,
      },
      body: JSON.stringify({
        message: trimmed,
      }),
    });

    const reply = response.reply || "";

    // Stop the thinking indicator and start typing animation.
    setMessages((current) =>
      current.map((message) =>
        message.id === assistantId
          ? {
              ...message,
              thinking: false,
              text: "",
            }
          : message,
      ),
    );

    // Type the response progressively.
    let typedText = "";

    for (let i = 0; i < reply.length; i++) {
      typedText += reply[i];

      setMessages((current) =>
        current.map((message) =>
          message.id === assistantId
            ? {
                ...message,
                text: typedText,
              }
            : message,
        ),
      );

      // Faster for normal text, slightly slower around punctuation.
      const delay =
        reply[i] === "." ||
        reply[i] === "!" ||
        reply[i] === "?" ||
        reply[i] === "\n"
          ? 28
          : 10;

      await new Promise((resolve) => setTimeout(resolve, delay));
    }
  } catch (error) {
    console.error("StudySync AI error:", error);

    setMessages((current) =>
      current.map((message) =>
        message.id === assistantId
          ? {
              ...message,
              thinking: false,
              text:
                error instanceof Error
                  ? error.message
                  : "StudySync AI could not respond right now.",
            }
          : message,
      ),
    );
  } finally {
    setSending(false);
  }
}

