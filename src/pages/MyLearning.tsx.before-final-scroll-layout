const CHAT_STORAGE_KEY = "studysync_ai_conversation";
const CHAT_HISTORY_KEY = "studysync_ai_chat_history";

function getChatTitle(messages: ChatMessage[]) {
  const firstUserMessage = messages.find(
    (message) => message.role === "user" && message.text.trim(),
  );

  if (!firstUserMessage) return "New conversation";

  const title = firstUserMessage.text.trim().replace(/\s+/g, " ");

  return title.length > 42 ? `${title.slice(0, 42)}…` : title;
}

function loadChatHistory(): ChatConversation[] {
  try {
    const savedHistory = localStorage.getItem(CHAT_HISTORY_KEY);

    if (savedHistory) {
      const parsed = JSON.parse(savedHistory);

      if (Array.isArray(parsed) && parsed.length > 0) {
        return parsed as ChatConversation[];
      }
    }
  } catch (error) {
    console.warn("Could not restore StudySync AI chat history:", error);
  }

  // Migrate the previous single-conversation storage.
  try {
    const oldConversation = localStorage.getItem(CHAT_STORAGE_KEY);

    if (oldConversation) {
      const parsed = JSON.parse(oldConversation);

      if (Array.isArray(parsed) && parsed.length > 0) {
        return [
          {
            id: `chat-${Date.now()}`,
            title: getChatTitle(parsed),
            messages: parsed as ChatMessage[],
            updatedAt: Date.now(),
          },
        ];
      }
    }
  } catch (error) {
    console.warn("Could not migrate old StudySync AI conversation:", error);
  }

  return [
    {
      id: "chat-default",
      title: "New conversation",
      messages: [INITIAL_CHAT_MESSAGE],
      updatedAt: Date.now(),
    },
  ];
}


