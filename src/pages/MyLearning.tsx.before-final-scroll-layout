                              ),
                              code: ({ children }) => (
                                <code className="break-all rounded-md bg-slate-200 px-1.5 py-0.5 text-[0.9em] text-violet-700 dark:bg-slate-700 dark:text-violet-300">
                                  {children}
                                </code>
                              ),
                            }}
                          >
                            {message.text}
                          </ReactMarkdown>
                        )}
                      </div>

                      {message.role === "assistant" && message.action && (
                        <button
                          type="button"
                          onClick={() => {
                            if (message.action === "focus") {
                              navigate("/focus");
                            }

                            if (message.action === "assignments") {
                              navigate("/assignments");
                            }

                            if (message.action === "planner") {
                              navigate("/planner");
                            }
                          }}
                          className="mt-3 inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-xs font-semibold text-violet-600 shadow-sm dark:bg-slate-900 dark:text-violet-400"
                        >
                          {message.action === "focus" ? (
                            <>
                              <Play size={13} />
                              Start Focus Session
                            </>
                          ) : message.action === "assignments" ? (
                            <>
                              <FileText size={13} />
                              View Assignments
                            </>
                          ) : (
                            <>
                              <CalendarDays size={13} />
                              Open Study Planner
                            </>
                          )}
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>

              {/* Error / Retry */}
              {retryMessage && !sending && (
                <div className="mx-4 mb-3 flex shrink-0 flex-col gap-2 rounded-2xl border border-rose-200 bg-rose-50 px-3 py-3 sm:mx-6 sm:flex-row sm:items-center sm:justify-between dark:border-rose-900/50 dark:bg-rose-950/30">
                  <p className="min-w-0 truncate text-xs text-rose-600 dark:text-rose-300">
                    Something went wrong while contacting StudySync AI.
                  </p>

                  <button
                    type="button"
                    onClick={() => {
                      const failedPrompt = retryMessage;
                      setRetryMessage(null);
                      sendPrompt(failedPrompt);
                    }}
                    className="shrink-0 rounded-lg bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-rose-700"
                  >
                    Retry
                  </button>
                </div>
              )}

              {/* Composer */}
              <div className="shrink-0 border-t border-slate-100 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 sm:p-4">
                <div className="flex min-w-0 items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-1.5 shadow-sm transition focus-within:border-violet-300 focus-within:ring-4 focus-within:ring-violet-500/10 dark:border-slate-800 dark:bg-slate-950 dark:focus-within:border-violet-700">
                  <input
                    ref={composerRef}
                    value={prompt}
                    onChange={(event) => setPrompt(event.target.value)}
                    onKeyDown={(event) => {
                      if (event.key === "Enter") {
                        event.preventDefault();
                        sendPrompt();
                      }
                    }}
                    placeholder="Continue the conversation..."
                    className="min-w-0 flex-1 bg-transparent px-3 py-3 text-sm text-slate-800 outline-none placeholder:text-slate-400 dark:text-white"
                  />

                  <button
                    type="button"
                    onClick={() => sendPrompt()}
                    disabled={!prompt.trim() || sending}
                    className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-600 text-white transition hover:bg-violet-700 disabled:opacity-40"
                  >
                    <Send size={16} />
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* Academic Context */}
        <aside className="space-y-4">
          <section className="rounded-[26px] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div className="flex items-center gap-2">
              <GraduationCap
                size={18}
                className="text-cyan-500"
              />
              <h2 className="font-bold text-slate-900 dark:text-white">
                Your Academic Context
              </h2>
            </div>

            <div className="mt-5 grid grid-cols-2 gap-3">
              <div className="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
                <p className="text-[11px] text-slate-400">
                  Today's Tasks
                </p>
                <p className="mt-1 text-xl font-bold text-slate-900 dark:text-white">
                  {pendingAssignments.length}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
                <p className="text-[11px] text-slate-400">
                  Completed
                </p>
                <p className="mt-1 text-xl font-bold text-slate-900 dark:text-white">
                  {completedAssignments.length}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
                <p className="text-[11px] text-slate-400">
                  Study Today
                </p>
                <p className="mt-1 text-xl font-bold text-slate-900 dark:text-white">
                  {formatMinutes(todayMinutes)}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/70">
                <p className="text-[11px] text-slate-400">
                  Learning Score
                </p>
                <p className="mt-1 text-xl font-bold text-slate-900 dark:text-white">
                  {learningScore}%
                </p>
              </div>
            </div>

            <div className="mt-4 rounded-2xl border border-violet-100 bg-violet-50/60 p-4 dark:border-violet-500/20 dark:bg-violet-500/10">
              <p className="text-[11px] font-semibold uppercase tracking-wider text-violet-500">
                Current Focus
              </p>

              <p className="mt-1 font-semibold text-slate-800 dark:text-white">
                {currentSubject}
              </p>

              <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                {formatMinutes(weeklyMinutes)} focused this week
              </p>
            </div>
          </section>

          {/* Next deadline */}
          <section className="rounded-[26px] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div className="flex items-center gap-2">
              <Clock3 size={18} className="text-orange-500" />
              <h2 className="font-bold text-slate-900 dark:text-white">
                Next Deadline
              </h2>
            </div>

            {nextAssignment ? (
              <>
                <p className="mt-4 font-semibold text-slate-800 dark:text-white">
                  {nextAssignment.title}
                </p>

                <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  {nextAssignment.subject}
                  {nextAssignment.due_date
                    ? ` · Due ${nextAssignment.due_date}`
                    : ""}
                </p>

                <button
                  type="button"
                  onClick={() => navigate("/assignments")}
                  className="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-3 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                >
                  Open Assignment
                  <ArrowRight size={14} />
                </button>
              </>
            ) : (
              <p className="mt-4 text-sm text-slate-500 dark:text-slate-400">
                No upcoming deadlines. You're clear.
              </p>
            )}
          </section>
        </aside>
      </div>

      {/* Recommended */}
      <section>
        <div className="mb-4 flex items-end justify-between gap-4">
          <div>
            <div className="flex items-center gap-2">
              <Lightbulb size={17} className="text-amber-500" />
              <h2 className="font-bold text-slate-900 dark:text-white">
                Recommended for you
              </h2>
            </div>

            <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Based on your current assignments and study activity.
            </p>
          </div>
        </div>

        <div className="grid gap-4 lg:grid-cols-2">
          <div className="rounded-[24px] border border-violet-100 bg-gradient-to-br from-violet-50 to-indigo-50 p-6 dark:border-violet-500/20 dark:from-violet-500/10 dark:to-indigo-500/10">
            <div className="flex items-start justify-between gap-4">
              <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-violet-600 shadow-sm dark:bg-slate-900">
                <Target size={20} />
              </div>

              <span className="rounded-full bg-white px-3 py-1 text-[10px] font-bold text-violet-600 dark:bg-slate-900 dark:text-violet-400">
                NEXT STEP
              </span>
            </div>

            <p className="mt-5 text-xs font-semibold uppercase tracking-wider text-violet-500">
              {recommendation.subject}
            </p>

            <h3 className="mt-1 text-lg font-bold text-slate-900 dark:text-white">
              {recommendation.title}
            </h3>

            <p className="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              {recommendation.reason}
            </p>

            <div className="mt-5 flex flex-wrap items-center gap-3">
              <button
                type="button"
                onClick={() => navigate("/focus")}
                className="inline-flex items-center gap-2 rounded-xl bg-violet-600 px-4 py-3 text-xs font-semibold text-white shadow-lg shadow-violet-500/20 transition hover:bg-violet-700"
              >
                <Play size={14} />
                Start {recommendation.minutes} min Focus
              </button>

              <button
                type="button"
                onClick={() => navigate("/planner")}
                className="inline-flex items-center gap-2 rounded-xl border border-white bg-white px-4 py-3 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
              >
                <CalendarDays size={14} />
                Add to Plan
              </button>
            </div>
          </div>

          <div className="rounded-[24px] border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <div className="flex items-center gap-2">
              <TrendingUp size={18} className="text-emerald-500" />
              <h3 className="font-bold text-slate-900 dark:text-white">
                StudySync Insights
              </h3>
            </div>

            <div className="mt-5 space-y-3">
              <div className="flex items-start gap-3">
                <CheckCircle2
                  size={17}
                  className="mt-0.5 shrink-0 text-emerald-500"
                />
                <p className="text-sm text-slate-600 dark:text-slate-300">
                  You've completed{" "}
                  <strong>{completedAssignments.length}</strong>{" "}
                  assignment
                  {completedAssignments.length === 1 ? "" : "s"} so far.
                </p>
              </div>

              <div className="flex items-start gap-3">
                <Clock3
                  size={17}
                  className="mt-0.5 shrink-0 text-violet-500"
                />
                <p className="text-sm text-slate-600 dark:text-slate-300">
                  You've focused for{" "}
                  <strong>{formatMinutes(weeklyMinutes)}</strong>{" "}
                  this week.
                </p>
              </div>

              <div className="flex items-start gap-3">
                <Target
                  size={17}
                  className="mt-0.5 shrink-0 text-orange-500"
                />
                <p className="text-sm text-slate-600 dark:text-slate-300">
                  Your current study subject is{" "}
                  <strong>{currentSubject}</strong>.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Recent activity */}
      <section className="rounded-[26px] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
        <div className="flex items-center justify-between gap-4">
          <div>
            <h2 className="font-bold text-slate-900 dark:text-white">
              Recent Learning Activity
            </h2>
            <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Your latest Focus Mode sessions.
            </p>
          </div>

          <button
            type="button"
            onClick={() => navigate("/focus")}
            className="text-xs font-semibold text-violet-600 dark:text-violet-400"
          >
            Open Focus Mode →
          </button>
        </div>

        {recentActivity.length === 0 ? (
          <div className="mt-5 rounded-2xl bg-slate-50 p-6 text-center dark:bg-slate-800/60">
            <p className="text-sm font-semibold text-slate-700 dark:text-slate-200">
              No study sessions yet
            </p>
            <p className="mt-1 text-xs text-slate-400">
              Start your first Focus session and your activity will appear here.
            </p>
          </div>
        ) : (
          <div className="mt-5 divide-y divide-slate-100 dark:divide-slate-800">
            {recentActivity.map((session) => (
              <div
                key={session.id}
                className="flex items-center justify-between gap-4 py-4 first:pt-0 last:pb-0"
              >
                <div className="flex min-w-0 items-center gap-3">
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600 dark:bg-violet-500/10 dark:text-violet-400">
                    <CheckCircle2 size={18} />
                  </div>

                  <div className="min-w-0">
                    <p className="truncate text-sm font-semibold text-slate-800 dark:text-slate-100">
                      {session.subject || "General Study"}
                    </p>

                    <p className="mt-0.5 text-xs text-slate-400">
                      {formatActivityDate(session.started_at)}
                    </p>
                  </div>
                </div>

                <span className="shrink-0 text-xs font-semibold text-slate-500 dark:text-slate-400">
                  {formatMinutes(
                    session.duration_seconds
                      ? Math.round(session.duration_seconds / 60)
                      : session.duration_minutes,
                  )}
                </span>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Small context footer */}
      <div className="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-900/60">
        <div className="flex items-center gap-3">
          <GraduationCap size={18} className="text-violet-500" />
          <div>
            <p className="text-xs font-semibold text-slate-700 dark:text-slate-200">
              {subjects.length} subjects connected
            </p>
            <p className="text-[11px] text-slate-400">
              StudySync AI uses your workspace context for recommendations.
            </p>
          </div>
        </div>

        <button
          type="button"
          onClick={() => navigate("/profile")}
          className="text-xs font-semibold text-violet-600 dark:text-violet-400"
        >
          Update profile →
        </button>
      </div>
    </div>
  );
}
