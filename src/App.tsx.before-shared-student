              } this week`}
              accent="violet"
            />
            <StatCard
              icon={<CheckCircle2 size={19} />}
              label="Completed"
              value={`${assignmentStats.completed} / ${assignmentStats.total}`}
              detail={
                assignmentStats.total - assignmentStats.completed > 0
                  ? `${assignmentStats.total - assignmentStats.completed} ${
                      assignmentStats.total - assignmentStats.completed === 1
                        ? "task"
                        : "tasks"
                    } remaining`
                  : assignmentStats.total > 0
                    ? "All assignments completed"
                    : "No assignments yet"
              }
              accent="emerald"
            />
            <StatCard
              icon={<Brain size={19} />}
              label="Learning score"
              value={`${learningScore}%`}
              detail={`${assignmentCompletion}% assignments completed · ${weeklyGoalProgress}% weekly focus goal`}
              accent="cyan"
            />
          </section>
          <section className="grid gap-6 xl:grid-cols-[1.45fr_0.85fr]">
            {/* Assignments */}
            <div className="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
              <div className="mb-6 flex items-center justify-between">
                <div>
                  <h3 className="font-semibold">Assignments</h3>
                  <p className="mt-1 text-xs text-slate-600">
                    Keep your upcoming work under control.
                  </p>
                </div>
                <button
                  onClick={() => navigate("/assignments")}
                  className="text-xs font-semibold text-violet-600 hover:text-violet-500"
                >
                  View all
                </button>
              </div>
              <div className="space-y-3">
                {assignmentsLoading ? (
                  <div className="flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 py-10 text-sm text-slate-500">
                    Loading assignments...
                  </div>
                ) : dashboardAssignments.length === 0 ? (
                  <div className="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-5 py-10 text-center">
                    <FileText className="mx-auto text-slate-300" size={28} />
                    <p className="mt-3 text-sm font-semibold text-slate-700">
                      No assignments yet
                    </p>
                    <p className="mt-1 text-xs text-slate-500">
                      Add your first assignment to see it here.
                    </p>
                    <button
                      onClick={() => navigate("/assignments")}
                      className="mt-4 rounded-xl bg-slate-950 px-4 py-2 text-xs font-semibold !text-white hover:bg-violet-600"
                    >
                      Add Assignment
                    </button>
                  </div>
                ) : (
                  dashboardAssignments.map((item, index) => (
                    <motion.div
                      key={item.id}
                      initial={{ opacity: 0, y: 8 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: index * 0.08 }}
                      className="group rounded-xl border border-slate-200 bg-slate-50 p-3 transition hover:border-violet-200 hover:bg-white"
                    >
                      <div className="flex items-start gap-3">
                        <div
                          className={`mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${
                            item.color === "violet"
                              ? "bg-violet-500/10 text-violet-600"
                              : item.color === "cyan"
                                ? "bg-cyan-500/10 text-cyan-600"
                                : item.color === "emerald"
                                  ? "bg-emerald-500/10 text-emerald-600"
                                  : "bg-orange-500/10 text-orange-600"
                          }`}
                        >
                          <FileText size={18} />
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="flex items-start justify-between gap-3">
                            <div className="min-w-0">
                              <p className="truncate text-sm font-semibold text-slate-900">
                                {item.title}
                              </p>
                              <p className="mt-1 text-xs text-slate-500">
                                {item.subject}
                              </p>
                            </div>
                            <span
                              className={`shrink-0 rounded-full px-2 py-1 text-[10px] font-bold ${
                                item.priority === "High"
                                  ? "bg-rose-50 text-rose-600"
                                  : item.priority === "Low"
                                    ? "bg-emerald-50 text-emerald-600"
                                    : "bg-amber-50 text-amber-600"
                              }`}
                            >
                              {item.priority}
                            </span>
                          </div>
                          <div className="mt-3 flex items-center justify-between">
                            <span className="text-[11px] font-medium text-slate-500">
                              {item.completed ? "Completed" : `Due ${item.due}`}
                            </span>
                            <span className="text-[11px] font-semibold text-slate-400">
                              {item.estimated_minutes >= 60
                                ? `${Math.floor(item.estimated_minutes / 60)}h ${item.estimated_minutes % 60 ? `${item.estimated_minutes % 60}m` : ""}`
                                : `${item.estimated_minutes}m`}
                            </span>
                          </div>
                          <div className="mt-3 flex items-center gap-3">
                            <div className="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200">
                              <div
                                className="h-full rounded-full bg-violet-500 transition-all"
                                style={{
                                  width: `${
                                    item.completed
                                      ? 100
                                      : Math.min(
                                          100,
                                          Math.round(
                                            ((assignmentFocusSeconds[item.id] || 0) /
                                              Math.max(
                                                1,
                                                item.estimated_minutes * 60,
                                              )) *
                                              100,
                                          ),
                                        )
                                  }%`,
                                }}
                              />
                            </div>
                            <span className="shrink-0 text-[10px] font-bold text-slate-500">
                              {item.completed
                                ? "100%"
                                : `${Math.min(
                                    100,
                                    Math.round(
                                      ((assignmentFocusSeconds[item.id] || 0) /
                                        Math.max(
                                          1,
                                          item.estimated_minutes * 60,
                                        )) *
                                        100,
                                    ),
                                  )}%`}
                            </span>
                          </div>
                        </div>
                      </div>
                    </motion.div>
                  ))
                )}
              </div>
            </div>
          </section>
          {/* Bottom widgets */}
          <section className="mt-6 grid gap-6 lg:grid-cols-2">
            <div className="relative overflow-hidden rounded-2xl border border-violet-500/15 bg-gradient-to-br from-violet-500/[0.11] via-white/[0.025] to-cyan-500/[0.04] p-6">
              <div className="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-violet-500/10 blur-3xl" />
              <div className="relative">
                <div className="mb-4 flex items-center gap-2 text-violet-300">
                  <Sparkles size={17} />
                  <span className="text-xs font-bold uppercase tracking-widest">
                    StudySync AI
                  </span>
                </div>
                <h3 className="max-w-md text-xl font-semibold">
                  What do you want to learn today?
                </h3>
                <p className="mt-2 max-w-lg text-sm leading-6 text-slate-600">
                  Generate a study plan, explain a difficult concept, create
                  practice questions, or review your progress.
                </p>
                <button className="mt-5 flex items-center gap-2 rounded-xl bg-violet-500 px-4 py-2.5 text-sm font-semibold text-slate-900 shadow-lg shadow-violet-500/20 hover:bg-violet-400">
                  Start with StudySync AI
                  <ChevronRight size={16} />
                </button>
              </div>
            </div>
            <div className="rounded-2xl border border-slate-200 bg-white p-6">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="font-semibold">Weekly focus goal</h3>
                  <p className="mt-1 text-xs text-slate-600">
                    {formatStudyDuration(weeklyGoalSeconds)} target
                  </p>
                </div>
                <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-400/10 text-cyan-400">
                  <Target size={18} />
                </div>
              </div>
              <div className="mt-6 flex items-end justify-between">
                <div>
                  <span className="text-3xl font-bold">
                    {formatStudyDuration(weeklyFocusSeconds)}
                  </span>
                  <span className="ml-2 text-xs text-slate-600">
                    / {formatStudyDuration(weeklyGoalSeconds)}
                  </span>
                </div>
                <span className="text-xs font-semibold text-slate-500">
                  {weeklyGoalProgress}%
                </span>
              </div>
              <div className="mt-4 h-2 overflow-hidden rounded-full bg-white">
                <motion.div
                  initial={{ width: 0 }}
                  animate={{ width: `${weeklyGoalProgress}%` }}
                  transition={{ duration: 1 }}
                  className="h-full rounded-full bg-gradient-to-r from-cyan-400 to-violet-500"
                />
              </div>
              <div className="mt-4 flex items-center justify-between text-[11px] text-slate-600">
                <span>
                  {weeklyGoalSeconds > weeklyFocusSeconds
                    ? `${formatStudyDuration(
                        weeklyGoalSeconds - weeklyFocusSeconds,
                      )} remaining`
                    : "Weekly goal reached"}
                </span>
                <span>
                  {weeklyGoalProgress >= 100
                    ? "Goal reached"
                    : "Keep going"}
                </span>
              </div>
            </div>
          </section>
              </>
            } />
          </Routes>
        </div>
      </main>
    </div>
  );
}
function StatCard({
  icon,
  label,
  value,
  detail,
  accent,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
  detail: string;
  accent: "orange" | "violet" | "emerald" | "cyan";
}) {
  const styles = {
    orange: "bg-orange-400/10 text-orange-400",
    violet: "bg-violet-500/10 text-violet-400",
    emerald: "bg-emerald-400/10 text-emerald-400",
    cyan: "bg-cyan-400/10 text-cyan-400",
  };
  return (
    <motion.div
      whileHover={{ y: -2 }}
      className="group rounded-2xl border border-slate-200 bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-violet-200 hover:bg-white hover:shadow-xl hover:shadow-black/10"
    >
      <div className="flex items-start justify-between">
        <div className={`rounded-xl p-2.5 ${styles[accent]}`}>{icon}</div>
        <MoreHorizontal size={17} className="text-slate-700" />
      </div>
      <p className="mt-5 text-xs font-medium text-slate-600">{label}</p>
      <p className="mt-1 text-2xl font-bold tracking-tight">{value}</p>
      <p className="mt-1 text-[11px] text-slate-600">{detail}</p>
    </motion.div>
  );
}
export default App;
